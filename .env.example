# 复制为 .env 并填写；部署时在对应平台的环境变量里填同样的值。
PORT=8080

# 可选：真实大模型（留空则用内置离线检索增强摘要）
RAG_LLM_PROVIDER=openai
RAG_LLM_BASE=https://api.openai.com/v1
RAG_LLM_KEY=sk-xxx
RAG_LLM_MODEL=gpt-4o-mini
RAG_TEMPERATURE=0.2

# 可选：多模型降级（主备自动切换）。留空则只用上面的单模型。
# 设为 JSON 数组即可开启；每个元素 {name,provider,base_url,api_key,model,priority,timeout,max_retries}
# 例：主用 gpt-4o-mini，备用 DeepSeek，再备通义千问（均 OpenAI 兼容 /chat/completions）
# RAG_LLM_MODELS=[{"name":"primary","provider":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-xxx","model":"gpt-4o-mini","priority":0,"timeout":120,"max_retries":2},{"name":"deepseek","provider":"openai","base_url":"https://api.deepseek.com/v1","api_key":"sk-ds-xxx","model":"deepseek-chat","priority":1,"timeout":60,"max_retries":1}]
# 切换/恢复告警 webhook（Slack/飞书/Alertmanager 均可）；留空则只打日志
# RAG_LLM_ALERT_WEBHOOK=
# 降级阈值旋钮（一般无需改）
# RAG_LLM_FAILURE_THRESHOLD=3
# RAG_LLM_COOLDOWN=60.0
# RAG_LLM_MAX_RETRIES=2
# RAG_LLM_TOTAL_TIMEOUT=120.0
# RAG_LLM_DEGRADE_THRESHOLD=1
# RAG_LLM_TIMEOUT=120

# 可选：真实 Embedding（留空则用 TF-IDF 教学近似）
RAG_EMB_KIND=tfidf
RAG_EMB_BASE=https://api.openai.com/v1
RAG_EMB_KEY=
RAG_EMB_MODEL=text-embedding-3-small

# 可选：开启访问令牌（设了则必须带 Authorization: Bearer <token>）
RAG_TOKEN=
